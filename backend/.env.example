# ---------------------------------------------------------------------------
# All in One News API - environment configuration
# Copy to `.env` and adjust. Every value can also be set as a real
# environment variable (environment variables win over the .env file).
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development

# Database. SQLite is fine for local development; use PostgreSQL in production.
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./data/allinone.db

# REQUIRED in production: a long random string (e.g. `openssl rand -hex 48`).
SECRET_KEY=change-me-in-production-please-use-a-long-random-value

# Access token lifetime for admin sessions (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Public base URL of this API, used to build absolute media URLs that the
# mobile app downloads (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8000

# Comma separated list of origins allowed to call the admin API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Uploads
MEDIA_ROOT=./uploads
MAX_UPLOAD_MB=25

# First administrator, created automatically on start-up when no admin exists.
# Remove these values after the first start.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe!2026

# Load demo categories/websites on first start when the database is empty.
SEED_DEMO_DATA=true

# Optional: serve the built admin panel from the API at /admin
# ADMIN_STATIC_DIR=../admin/dist
