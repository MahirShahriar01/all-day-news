# Your domain, pointed at this server with a DNS "A" record. HTTPS
# certificates are issued automatically by Caddy (Let's Encrypt).
DOMAIN=news.example.com
ACME_EMAIL=you@example.com

# Generate long random values, e.g.:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-to-a-64-character-random-string

# First administrator (created on first start only). Change the password
# after the first login, then you may delete these two lines.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe!2026

# Insert demo categories and websites into an empty database (true/false).
SEED_DEMO_DATA=true
MAX_UPLOAD_MB=25
WEB_CONCURRENCY=2
